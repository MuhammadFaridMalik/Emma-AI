# Salin file ini menjadi ".env" (tanpa .example) lalu isi nilainya.
# JANGAN commit file ".env" ke Git - sudah dimasukkan ke .gitignore.

# URL endpoint chat completions (format OpenAI-compatible).
# Bisa diganti ke provider lain: OpenRouter, Groq, Together, dll,
# selama endpoint-nya memakai skema request/response yang sama.
EMMA_AI_API_URL=https://api.openai.com/v1/chat/completions

# API key AI kamu. JANGAN pernah ditaruh di file JS/frontend.
EMMA_AI_API_KEY=your_api_key_here

# Model yang dipakai.
EMMA_AI_MODEL=gpt-4o-mini